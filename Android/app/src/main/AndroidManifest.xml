<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Weather (NOAA/aviationweather.gov, NASA GIBS), real-world D-ATIS, and
         OpenStreetMap airport surface data over the internet, plus the local-network
         link to Infinite Flight Connect on TCP 10112. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Auto-discovery broadcasts a UDP probe on the local subnet and listens for
         Infinite Flight's announcement. ACCESS_WIFI_STATE reads the subnet
         broadcast address; CHANGE_WIFI_MULTICAST_STATE holds a multicast lock so
         broadcast datagrams are delivered while the screen is off. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Android 16+ local network protections. Declared so the app keeps working when
         the platform begins enforcing runtime consent for local-network access.
         Deliberately NOT accompanied by any location permission: discovery uses
         plain UDP broadcast, which needs no location access. -->
    <uses-permission android:name="android.permission.LOCAL_NETWORK_ACCESS" />

    <!-- The live flight notification (ongoing / Live Update). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The active-flight session keeps the Infinite Flight connection, the ATC
         engine and spoken radio running while the app is not on screen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Spoken ATC and radio effects. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Push-to-talk only. Requested at runtime the first time push-to-talk is used,
         and never otherwise; recognition runs on-device where the platform offers it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Text-to-speech engine visibility on Android 11+ package-visibility rules. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".IFATCCompanionApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.IFATCCompanion.Starting"
        tools:targetApi="36">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.IFATCCompanion.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Started only by an explicit user action (Connect / Start Flight) while the
             app is visible, so it never trips the background-start restrictions. -->
        <service
            android:name=".service.ActiveFlightService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".notification.FlightNotificationActionReceiver"
            android:exported="false" />

    </application>
</manifest>
