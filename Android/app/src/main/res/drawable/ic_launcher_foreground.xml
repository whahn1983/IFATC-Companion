<?xml version="1.0" encoding="utf-8"?>
<!--
  Radar rings, sweep and aircraft — the same composition as the iOS app icon,
  redrawn as a vector so it stays crisp at every adaptive-icon mask and size.
  Everything sits inside the 66dp guaranteed-visible circle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sweep wedge, 30°–75° from north. -->
    <path
        android:pathData="M54,54 L69,28.02 A30,30 0 0,1 82.98,46.24 Z"
        android:fillColor="#4CDEB1"
        android:fillAlpha="0.32" />

    <!-- Range rings. -->
    <path
        android:pathData="M54,24 A30,30 0 1,1 54,84 A30,30 0 1,1 54,24 Z"
        android:strokeColor="#B4E1FF"
        android:strokeAlpha="0.42"
        android:strokeWidth="1.4" />
    <path
        android:pathData="M54,34 A20,20 0 1,1 54,74 A20,20 0 1,1 54,34 Z"
        android:strokeColor="#B4E1FF"
        android:strokeAlpha="0.34"
        android:strokeWidth="1.2" />
    <path
        android:pathData="M54,44 A10,10 0 1,1 54,64 A10,10 0 1,1 54,44 Z"
        android:strokeColor="#B4E1FF"
        android:strokeAlpha="0.28"
        android:strokeWidth="1.1" />

    <!-- Crosshair. -->
    <path
        android:pathData="M24,54 L84,54 M54,24 L54,84"
        android:strokeColor="#B4E1FF"
        android:strokeAlpha="0.3"
        android:strokeWidth="1.1" />

    <!-- Centre blip. -->
    <path
        android:pathData="M54,51.4 A2.6,2.6 0 1,1 54,56.6 A2.6,2.6 0 1,1 54,51.4 Z"
        android:fillColor="#B4E1FF" />

    <!-- Aircraft, banked north-east along the sweep. -->
    <group android:translateX="62" android:translateY="44">
        <group android:rotation="45" android:scaleX="1.55" android:scaleY="1.55">
            <group android:translateX="-12" android:translateY="-12">
                <path
                    android:pathData="M21,16v-2l-8,-5V3.5C13,2.67 12.33,2 11.5,2S10,2.67 10,3.5V9l-8,5v2l8,-2.5V19l-2,1.5V22l3.5,-1 3.5,1v-1.5L13,19v-5.5L21,16z"
                    android:fillColor="#FFFFFF" />
            </group>
        </group>
    </group>
</vector>
